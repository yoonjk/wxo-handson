        "script_cae7a7": {
          "spec": {
            "fn": "loop = flow[\"Process items\"].private\nitem = loop.current_item\n\nresult = {\n    \"sku\": item[\"sku\"],\n    \"quantity\": int(item[\"quantity\"]),\n    \"unit_price\": int(loop.unit_price),\n    \"line_total\": int(loop.line_total)\n}\n\nlines = list(flow.private.lines or [])\nlines.append(result)\n\nflow.private.lines = lines\nflow.private.total = int(flow.private.total or 0) + int(loop.line_total)\nloop.line_result = result",
            "kind": "script",
