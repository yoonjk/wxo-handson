      "nodes": {
        "script_286465": {
          "spec": {
            "fn": "loop = flow[\"Process items\"].private\nitem = loop.current_item\n\nprices = {\n    \"NOTEBOOK\": 1200000,\n    \"MONITOR\": 300000,\n    \"KEYBOARD\": 100000\n}\n\nsku = item[\"sku\"]\nloop.unit_price = prices.get(sku)\n\nif loop.unit_price is None:\n    raise ValueError(\"Unknown SKU: \" + str(sku))",
            "kind": "script",
            "name": "script_286465",
            "position": {
              "x": 39.18410701518829,
              "y": 67
            },
            "display_name": "Determine unit price",
            "output_schema": {
              "type": "object",
              "properties": {
