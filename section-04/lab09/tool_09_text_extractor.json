    "script_0fd3f9": {
      "spec": {
        "fn": "# Text extractor\uc758 \uc804\uccb4 Object \uacb0\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4.\nresult = flow[\"Text extractor 1\"].output\n\n# KVP \ubc30\uc5f4\uc744 \uac00\uc838\uc635\ub2c8\ub2e4.\nif isinstance(result, dict):\n    kvps = result.get(\"kvps\") or []\nelse:\n    kvps = getattr(result, \"kvps\", []) or []\n\npurchase_request = {\n    \"requester\": \"\",\n    \"department\": \"\",\n    \"request_date\": \"\",\n    \"currency\": \"\",\n    \"budget\": 0,\n    \"total\": 0,\n    \"reason\": \"\",\n    \"items\": []\n}\n\nitems_by_row = {}\n\nfor kvp in kvps:\n    key = kvp.get(\"key\") or {}\n    value = kvp.get(\"value\") or {}\n\n    label = key.get(\"semantic_label\", \"\")\n    raw_value = value.get(\"normalized_text\") or value.get(\"raw_text\") or \"\"\n\n    table_name = kvp.get(\"table_name\")\n    row_index = kvp.get(\"table_row_index\")\n\n    # items \ud14c\uc774\ube14\uc758 \uac12 \ucc98\ub9ac\n    if table_name == \"items\" and row_index is not None:\n        item = items_by_row.setdefault(\n            row_index,\n            {\n                \"sku\": \"\",\n                \"quantity\": 0,\n                \"unit_price\": 0\n            }\n        )\n\n        if label == \"sku\":\n            item[\"sku\"] = raw_value\n        elif label == \"quantity\":\n            item[\"quantity\"] = int(raw_value)\n        elif label in (\"unitprice\", \"unit_price\"):\n            item[\"unit_price\"] = int(raw_value)\n\n    # \uc77c\ubc18 \ud544\ub4dc \ucc98\ub9ac\n    elif label == \"requester\":\n        purchase_request[\"requester\"] = raw_value\n    elif label == \"department\":\n        purchase_request[\"department\"] = raw_value\n    elif label == \"request_date\":\n        purchase_request[\"request_date\"] = raw_value\n    elif label == \"currency\":\n        purchase_request[\"currency\"] = raw_value\n    elif label == \"budget\":\n        purchase_request[\"budget\"] = int(raw_value)\n    elif label == \"total\":\n        purchase_request[\"total\"] = int(raw_value)\n    elif label == \"reason\":\n        purchase_request[\"reason\"] = raw_value\n\n# \ud589 \ubc88\ud638 \uc21c\uc11c\ub300\ub85c \ud488\ubaa9 \ubc30\uc5f4\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4.\npurchase_request[\"items\"] = [\n    items_by_row[row_index]\n    for row_index in sorted(items_by_row)\n]\n\n# \ud488\ubaa9 \ud569\uacc4\ub97c \uacc4\uc0b0\ud569\ub2c8\ub2e4.\nitem_total = sum(\n    item[\"quantity\"] * item[\"unit_price\"]\n    for item in purchase_request[\"items\"]\n)\n\npurchase_request[\"item_total\"] = item_total\npurchase_request[\"items_count\"] = len(purchase_request[\"items\"])\n\n# \uc608\uc0b0 \ucd08\uacfc \uc5ec\ubd80\ub97c \uacc4\uc0b0\ud569\ub2c8\ub2e4.\nif item_total > purchase_request[\"budget\"]:\n    purchase_request[\"approval_status\"] = \"REJECT\"\nelse:\n    purchase_request[\"approval_status\"] = \"APPROVED\"\n\n# Workflow \ucd9c\ub825\uc73c\ub85c \uc804\ub2ec\ud569\ub2c8\ub2e4.\nflow.private.purchase_request = purchase_request\nflow.private.approval_status = purchase_request[\"approval_status\"]",
        "kind": "script",
        "name": "script_0fd3f9",
        "position": {
          "x": -1.0000000000000284,
          "y": 656.2603870107527
        },
        "display_name": "Set purchase_request"
      }
    },
