    "script_21d231": {
      "spec": {
        "fn": "# Generative prompt\uc758 \ucd9c\ub825\uac12\uc744 \uac00\uc838\uc635\ub2c8\ub2e4.\nprompt_output = flow[\"Generative prompt\"].output\n\n# \ucd9c\ub825\uac12\uc774 JSON \ubb38\uc790\uc5f4\uc778 \uacbd\uc6b0 \uac1d\uccb4\ub85c \ubcc0\ud658\ud569\ub2c8\ub2e4.\nif isinstance(prompt_output, str):\n    prompt_output = json.loads(prompt_output)\n\n# \ucd9c\ub825 \uad6c\uc870\uac00 \ub2e4\uc74c\uacfc \uac19\uc740 \uacbd\uc6b0\ub97c \ucc98\ub9ac\ud569\ub2c8\ub2e4.\n# { \"purchase_request\": { ... } }\nif isinstance(prompt_output, dict) and \"purchase_request\" in prompt_output:\n    request = prompt_output[\"purchase_request\"]\nelse:\n    request = prompt_output\n\n# items\uac00 \uc5c6\uac70\ub098 None\uc774\uba74 \ube48 \ubc30\uc5f4\ub85c \ucc98\ub9ac\ud569\ub2c8\ub2e4.\nitems = request.get(\"items\") or []\n\n# \uc608\uc0b0 \uac12\uc744 \uc77d\uc2b5\ub2c8\ub2e4.\nbudget = request.get(\"budget\") or 0\n\n# \ud488\ubaa9\ubcc4 \ud569\uacc4\ub97c \uacc4\uc0b0\ud569\ub2c8\ub2e4.\nitem_total = 0\n\nfor item in items:\n    quantity = item.get(\"quantity\") or 0\n    unitprice = item.get(\"unitprice\") or 0\n\n    item_total += quantity * unitprice\n\n# Branch node\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uac12\uc744 \uc800\uc7a5\ud569\ub2c8\ub2e4.\nflow.private.item_total = item_total\nflow.private.budget = budget\nflow.private.items_count = len(items)\nflow.private.validation_error = (\n    \"\" if items else \"\uad6c\ub9e4 \ud488\ubaa9 \ubaa9\ub85d\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\"\n)",
        "kind": "script",
        "name": "script_21d231",
        "position": {
          "x": -13,
          "y": 848.21875
        },
        "display_name": "Calculate Items"
      }
    },
