# MySQL 연결 정보: 비밀번호는 실제 값을 파일에 직접 넣지 말고 로컬 .env에 설정하세요.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=demo
DB_USERNAME=nexweb
DB_PASSWORD=

# ITSM FastAPI bind address and port (run with: python -m app.main)
APP_HOST=0.0.0.0
APP_PORT=8000

# MCP 어댑터가 호출할 FastAPI REST 서비스
ITSM_API_BASE_URL=http://127.0.0.1:8000

# 내부 ITSM MCP → FastAPI REST 인증 토큰
ITSM_API_TOKEN=replace-with-a-long-random-demo-token

# Gateway → ITSM MCP 서버 인증 토큰
ITSM_MCP_BEARER_TOKEN=replace-with-a-different-long-random-token
ITSM_MCP_HOST=0.0.0.0
ITSM_MCP_PORT=8030

# IBM Bob Notification MCP Server 설정. 기존 SR_EVENT_* 변수명도 호환성 alias로 허용합니다.
# 이 bearer token은 Gateway가 Notification MCP transport를 호출할 때 사용합니다.
# Bob 관리자 화면은 사용자별 Bob token을 검증하며, 테스트 스크립트는 ITSM_API_TOKEN으로 공지를 발행합니다.
ITSM_EVENT_MCP_BEARER_TOKEN=replace-with-an-event-mcp-token
ITSM_EVENT_MCP_INTERNAL_URL=http://127.0.0.1:8032
ITSM_EVENT_MCP_HOST=0.0.0.0
ITSM_EVENT_MCP_PORT=8032

# 선택 사항인 최초 bootstrap 값입니다. 개발 예제 계정은 sql/006_seed_bob_notification_sample_data.sql로 넣을 수 있습니다.
# 운영 데이터베이스는 비워 두고 관리자 화면 또는 별도 안전한 설정을 사용하세요.
ITSM_EVENT_USER_TOKENS_JSON={}
ITSM_EVENT_USER_GROUPS_JSON={}
ITSM_EVENT_ADMIN_EMPLOYEE_NOS_JSON=[]

# watsonx Orchestrate A2A agent 호출 설정
# Discovery URL은 Orchestrate Agent Card 목록을 반환하는 agents/get endpoint입니다.
WXO_A2A_DISCOVERY_URL=
# 특정 agent card의 url 값을 직접 설정하면 Discovery보다 우선합니다.
WXO_A2A_AGENT_URL=
WXO_AGENT_NAME=
# 둘 중 하나를 설정하세요. token은 raw 값이며 'Bearer ' 접두사를 넣지 않습니다.
WXO_A2A_BEARER_TOKEN=
WXO_IAM_API_KEY=
WXO_IAM_TOKEN_URL=https://iam.cloud.ibm.com/identity/token
WXO_HTTP_TIMEOUT=60

# Gateway → A2A WXO MCP 서버 인증 토큰
WXO_MCP_BEARER_TOKEN=replace-with-a-third-long-random-token
WXO_MCP_HOST=0.0.0.0
WXO_MCP_PORT=8031
