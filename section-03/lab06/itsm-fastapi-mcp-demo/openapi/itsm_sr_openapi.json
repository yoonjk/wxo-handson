{
  "openapi": "3.0.3",
  "info": {
    "title": "ITSM SR & Bob Notifier API (wxO)",
    "version": "1.0.0",
    "description": "watsonx Orchestrate agent가 SR을 등록·조회하고 Bob 사용자에게 공지를 발행합니다. SR에 assignee_employee_no를 지정하면 담당자의 Bob Notifier에 SR 알림이 표시됩니다."
  },
  "servers": [
    {
      "url": "https://itsm-api.example.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/service-requests": {
      "post": {
        "operationId": "create_service_request",
        "summary": "SR 등록 (담당자 Bob 알림)",
        "description": "유지보수 요청(SR)을 등록합니다. assignee_employee_no에 담당자 사번을 넣으면 그 사용자의 Bob Notifier에 SR 알림이 즉시 표시됩니다. 사번이 없거나 틀리면 SR은 생성되지만 알림은 가지 않습니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceRequestCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록된 SR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceRequestView"
                }
              }
            }
          },
          "401": {
            "description": "토큰 오류"
          },
          "422": {
            "description": "검증 실패 또는 미등록/비활성 사용자",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/service-requests/{ticket_key}": {
      "get": {
        "operationId": "get_service_request",
        "summary": "SR 상세 조회",
        "description": "SR 번호(예: SR-123)로 SR의 현재 상태, 담당자, 작업 기록을 조회합니다.",
        "parameters": [
          {
            "name": "ticket_key",
            "in": "path",
            "required": true,
            "description": "SR 번호. 형식: SR-숫자",
            "schema": {
              "type": "string",
              "pattern": "^SR-[0-9]+$",
              "example": "SR-123"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SR 상세",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceRequestView"
                }
              }
            }
          },
          "401": {
            "description": "토큰 오류"
          },
          "404": {
            "description": "SR 없음"
          }
        }
      }
    },
    "/service-request-events/notifications": {
      "post": {
        "operationId": "publish_bob_notification",
        "summary": "Bob 사용자 공지 발행",
        "description": "Bob 사용자에게 공지를 보냅니다. target_type=user면 employee_nos(또는 employee_no), group이면 target_group을 지정합니다. target_type=all(전체 공지)은 사용자에게 확인을 받은 뒤에만 호출하세요.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationPublishRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "발행 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPublishResponse"
                }
              }
            }
          },
          "401": {
            "description": "토큰 오류"
          },
          "422": {
            "description": "검증 실패 또는 미등록/비활성 사용자",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ServiceRequestCreate": {
        "type": "object",
        "required": [
          "title",
          "description",
          "service_name",
          "requester"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "description": "유지보수 요청 제목"
          },
          "description": {
            "type": "string",
            "minLength": 3,
            "description": "증상, 영향, 재현 절차와 기대 결과"
          },
          "service_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "대상 애플리케이션/서비스"
          },
          "environment": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "default": "production"
          },
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ],
            "default": "MEDIUM"
          },
          "requester": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "요청자 이름"
          },
          "assignee": {
            "type": "string",
            "maxLength": 120,
            "nullable": true,
            "description": "담당자 이름(표시용)"
          },
          "assignee_employee_no": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "nullable": true,
            "description": "Bob 알림을 받을 담당자 사번. 추측하지 말고 사용자에게 확인한 값만 넣습니다."
          }
        }
      },
      "ServiceRequestView": {
        "type": "object",
        "properties": {
          "ticket_key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "service_name": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "IN_PROGRESS",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "requester": {
            "type": "string"
          },
          "assignee": {
            "type": "string",
            "nullable": true
          },
          "assignee_employee_no": {
            "type": "string",
            "nullable": true
          },
          "worklog": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NotificationLink": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "링크 표시 이름"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "http(s) URL"
          }
        }
      },
      "NotificationPublishRequest": {
        "type": "object",
        "required": [
          "target_type",
          "title",
          "message"
        ],
        "properties": {
          "target_type": {
            "type": "string",
            "enum": [
              "all",
              "group",
              "user"
            ],
            "description": "all=전체, group=그룹, user=지정 사번"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "target_group": {
            "type": "string",
            "maxLength": 64,
            "description": "target_type=group일 때만"
          },
          "employee_no": {
            "type": "string",
            "maxLength": 32,
            "description": "target_type=user, 한 명일 때. employee_nos와 동시 사용 불가"
          },
          "employee_nos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string"
            },
            "description": "target_type=user, 여러 명일 때. 중복 불가"
          },
          "request_id": {
            "type": "string",
            "maxLength": 64,
            "description": "선택: 호출 추적용 ID"
          },
          "links": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/NotificationLink"
            }
          }
        }
      },
      "NotificationPublishResponse": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "integer"
          },
          "event_type": {
            "type": "string"
          },
          "target_type": {
            "type": "string",
            "enum": [
              "all",
              "group",
              "user"
            ]
          },
          "title": {
            "type": "string"
          },
          "recipient_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {}
        }
      }
    }
  }
}