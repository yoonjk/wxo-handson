# ===== watsonx Orchestrate =====
# 예: https://api.us-south.watson-orchestrate.cloud.ibm.com
WXO_BASE_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com

# Orchestrate service instance의 tenant/instance ID
WXO_INSTANCE_ID=<tenant-id>

# Bob이 기본으로 호출할 Orchestrate Agent ID
WXO_AGENT_ID=<agent-id>

# IBM Cloud API Key
# 운영에서는 파일에 저장하지 말고 Secret Manager/환경변수를 사용하세요.
WXO_API_KEY=<ibm-cloud-api-key>

# ===== MCP Server =====
MCP_HOST=0.0.0.0
MCP_PORT=8000

# chat | a2a
DEFAULT_CALL_MODE=chat

# HTTP timeout (seconds)
HTTP_TIMEOUT=90
