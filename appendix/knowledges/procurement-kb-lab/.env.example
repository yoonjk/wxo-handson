# Copy to .env in the lab folder:  cp .env.example .env
# The server looks for .env in the current folder, then next to the code and its parent folders.

# Address the FastAPI app listens on. nginx forwards the public port to this one.
CUSTOM_SERVICE_HOST=127.0.0.1
CUSTOM_SERVICE_PORT=8070

# Basic auth (used by this lab). Must match the Orchestrate connection's Username / Password.
# Generate a password:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
AUTH_USERNAME=orchestrate
AUTH_PASSWORD=change-me-to-a-random-string

# Optional API key auth. Leave empty: Orchestrate's API Key knowledge connection currently
# fails at search time (KeyError: 'apikey') before calling this server.
# If set together with Basic auth, a request passes when EITHER matches.
AUTH_API_KEY=

# true = also log every header value (secrets masked) and the request body. Turn off after testing.
AUTH_DEBUG=false

# Search settings
# POLICY_DIR=./data
# POLICY_BASE_URL=https://intranet.example.com/policies
SEARCH_TOP_K=3
SEARCH_MIN_SCORE=0.4

# Log file (default: simple_service/custom_service.log)
# CUSTOM_SERVICE_LOG_FILE=./custom_service.log

# Proxy IPs whose X-Forwarded-For header is trusted (nginx on the same host)
CUSTOM_SERVICE_TRUSTED_PROXIES=127.0.0.1
