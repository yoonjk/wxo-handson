DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ITSM FastAPI bind address and port (run with: python -m app.main)
APP_HOST=0.0.0.0
APP_PORT=8030

# MCP 어댑터가 호출할 FastAPI REST 서비스
ITSM_API_BASE_URL=http://127.0.0.1:8030

# 내부 ITSM MCP → FastAPI REST 인증 토큰
ITSM_API_TOKEN=

# Gateway → ITSM MCP 서버 인증 토큰
ITSM_MCP_BEARER_TOKEN=
ITSM_MCP_HOST=0.0.0.0
ITSM_MCP_PORT=8050

# Transactional outbox를 읽어 MCP 도구와 cursor 기반 SSE feed를 제공
ITSM_EVENT_MCP_BEARER_TOKEN=
ITSM_EVENT_MCP_HOST=0.0.0.0
ITSM_EVENT_MCP_PORT=8040

ITSM_EVENT_USER_TOKENS_JSON={"EMP1001":"ltKKwahvYm8RVsbH-u_WCDIP-XiRMJvpjRN8PxWj0dc"}
ITSM_EVENT_USER_GROUPS_JSON={"EMP1001":["operations","managers"]}
ITSM_EVENT_ADMIN_EMPLOYEE_NOS_JSON=["EMP1001"]

ITSM_EVENT_MCP_ALLOWED_HOSTS='10.0.0.187:*'


# Asset file bytes remain outside MySQL. Use a persistent private directory writable by the MCP process.
ITSM_ASSETS_STORAGE_DIR=/home/ubuntu/itsm/assets
# Public address used for links returned to Bob; signed downloads expire after 15 minutes.
ITSM_EVENT_PUBLIC_BASE_URL=http://localhost
# Optional dedicated secret for signed asset download URLs. If blank, the event MCP bearer token is used.
ITSM_ASSET_SIGNING_SECRET=

ITSM_EVENT_MCP_INTERNAL_URL=http://127.0.0.1:8040

# A2A_MCP
WXO_MCP_HOST=0.0.0.0
WXO_MCP_BEARER_TOKEN=
WXO_MCP_PORT=8050
WXO_MCP_ALLOWED_HOSTS=''
WXO_ALLOWED_AGENTS="One-HR,연차 계산 Assistant"

# watsonx Orchestrate A2A agent 호출 설정
# Discovery URL은 Orchestrate Agent Card 목록을 반환하는 agents/get endpoint입니다.
WXO_A2A_DISCOVERY_URL=https://api.<region.watson-orchestrate.cloud.ibm.com/instances/<tenant-id>/v1/orchestrate/A2A

# 특정 agent card의 url 값을 직접 설정하면 Discovery보다 우선합니다.
WXO_A2A_AGENT_URL=
WXO_AGENT_NAME=
# 둘 중 하나를 설정하세요. token은 raw 값이며 'Bearer ' 접두사를 넣지 않습니다.
WXO_A2A_BEARER_TOKEN=
WXO_IAM_API_KEY=
WXO_IAM_TOKEN_URL=https://iam.cloud.ibm.com/identity/token
WXO_HTTP_TIMEOUT=60

# simple-service apikey
CUSTOM_SERVICE_HOST="0.0.0.0"
CUSTOM_SERVICE_PORT="8070"
#AUTH_API_KEY=
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_DEBUG="true"
