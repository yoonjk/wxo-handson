      "account_id": {
        "type": "string",
        "title": "Account Id",
        "description": "Account identifier."
      }
    },
    "required": [
      "account_id"
    ]
  },
  "output_schema": {
    "type": "string",
    "description": "A JSON string with the balance details, or a JSON error message."
  },
  "binding": {
