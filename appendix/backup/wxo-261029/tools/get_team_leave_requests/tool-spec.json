    "type": "object",
    "properties": {
      "manager_id": {
        "type": "string",
        "title": "Manager Id",
        "description": "\ud300\uc6d0\ub4e4\uc758 \ub9e4\ub2c8\uc800(\ud300\uc7a5)\uc5d0 \ud574\ub2f9\ud558\ub294 \uc0ac\ubc88"
      },
      "include_past": {
        "type": "boolean",
        "title": "Include Past",
        "description": "True\ub85c \uc8fc\uba74 \uc885\ub8cc\uc77c\uc774 \uc9c0\ub09c \ud734\uac00\ub3c4 \ud568\uaed8 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uae30\ubcf8\uac12\uc740 False (\uc9c0\ub09c \ud734\uac00 \uc81c\uc678).",
        "default": false
      }
    },
