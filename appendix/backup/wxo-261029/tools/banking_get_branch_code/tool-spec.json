{
  "name": "banking_get_branch_code",
  "description": "Get branch code given branch name or city.",
  "permission": "admin",
  "input_schema": {
    "type": "object",
    "properties": {
      "branch_query": {
        "type": "string",
        "title": "Branch Query",
        "description": "Branch name or city (case-insensitive)."
      }
    },
    "required": [
      "branch_query"
    ]
  },
  "output_schema": {
    "type": "string",
    "description": "The branch code, or \"-1\" if not found."
  },
  "binding": {
    "python": {
      "function": "banking_tools:banking_get_branch_code",
      "requirements": [
        "mysql-connector-python>=8.0.33"
      ]
    }
  },
  "response_format": "content"
}