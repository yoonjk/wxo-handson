        "script_26f6a3": {
          "spec": {
            "fn": "loop = flow['Process items'].private \nitem = loop.current_item\n\nresult = {\n    \"sku\": item['sku'],\n    'quantity': item['quantity'],\n    'unit_price': loop.unit_price,\n    'line_total': loop.line_total\n}\n\nlines = list(flow.private.lines or [])\nlines.append(result)\nflow.private.lines = lines\nflow.private.total = int(flow.private.total or 0) + int(loop.line_total)\n\n",
            "kind": "script",
            "name": "script_26f6a3",
            "position": {
              "x": 19,
              "y": 527
            },
            "display_name": "Build line result"
          }
        },
        "script_8f221d": {
          "spec": {
            "fn": "loop = flow[\"Process items\"].private\n\nitem  = loop.current_item\n\nloop.line_total = int(item[\"quantity\"]) * int(loop.unit_price)\n\n",
            "kind": "script",
            "name": "script_8f221d",
            "position": {
              "x": 20,
              "y": 426
            },
            "display_name": "Calculate line total"
          }
        },
        "script_9ecbce": {
          "spec": {
            "fn": "loop = flow[\"Process items\"].private\nitem = loop.current_item or {}\n\nif not isinstance(item, dict):\n    raise ValueError(f\"current item\uc774 \uac1d\uccb4\uac00 \uc544\ub2d9\ub2c8\ub2e4: {item!r}\")\n\nsku = item.get(\"sku\")\n\nif not sku:\n    raise ValueError(f\"current item\uc5d0 sku\uac00 \uc5c6\uc2b5\ub2c8\ub2e4: {item!r}\")\n\nloop.sku = str(sku).strip().upper()",
            "kind": "script",
            "name": "script_9ecbce",
            "position": {
              "x": 20,
              "y": 104
            },
            "display_name": "set sku name"
          }
        },
        "script_e8471a": {
          "spec": {
            "fn": "loop = flow[\"Process items\"].private\n\nloop.name = flow[\"Process items\"][\"Get product by API\"].output.name\n\nloop.unit_price = int(float(flow[\"Process items\"][\"Get product by API\"].output.unit_price))",
            "kind": "script",
            "name": "script_e8471a",
            "position": {
              "x": 20,
              "y": 316
            },
            "display_name": "Determine unit price"
          }
        },
